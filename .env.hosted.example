# Hosted PantryRun relay (relay.pantryrun.app) — environment template.
#
#   cp .env.hosted.example .env && chmod 600 .env
#   docker compose --profile hosted up -d
#
# .env is gitignored. Never commit real values. Full walkthrough:
# GroceryApp/docs/deploy-hosted-relay.md

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → (your tunnel) → the token in the
# "docker run … --token <TOKEN>" install command. Treat it like a password:
# anyone holding it can run your tunnel.
TUNNEL_TOKEN=

# ── Relay behind the tunnel ─────────────────────────────────────────────────
# Keep the relay's ports on loopback only; cloudflared reaches it over the
# compose network as http://relay:8080.
RELAY_BIND=127.0.0.1
# Rate limits key on X-Forwarded-For. Cloudflare's edge appends the real client
# IP as the rightmost entry and cloudflared passes it through: 1 trusted hop.
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1
# Serve the anonymous pool on the relay origin. The current app reads pool
# prices from the relay origin (cloud-flyer.ts), so a separate pool origin
# would break community prices. See the doc for the trade-off.
POOL_PORT=8080
# Families the relay will accept. Raise deliberately; the container is capped
# at 0.5 CPU / 256 MB.
MAX_FAMILIES=500

# ── Live prices (GET /api/prices/{deals,shelf}) ─────────────────────────────
# The StopHop Turso DB holds both tables the relay reads: flipp_deals (written
# by hermes-scripts weekly_flipp_scrape.py → flippscrape.write_turso) and
# store_prices (store_prices_scrape.py). Use a READ-ONLY token:
#   turso db tokens create stophop --read-only
# (run `turso db list` if the database name differs.)
TURSO_URL=https://stophop-arshad1416.aws-us-east-1.turso.io
TURSO_READ_TOKEN=

# ── Flyer extraction (POST /api/extract/flyer) — pick ONE ───────────────────
# Option A (free, images never leave the Pi): Ollama on the Pi host, listening
# on the docker bridge (OLLAMA_HOST=0.0.0.0:11434), with a vision model pulled.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen2.5-vl:7b
# Option B (paid, faster): Alibaba Cloud Model Studio / DashScope. Images are
# sent to Alibaba Cloud — the privacy policy (§7) already says so. Leave empty
# to use Option A. Use the international (Singapore) endpoint unless you
# deliberately want mainland China.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
